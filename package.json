{
  "name": "zk-credit-score",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A protocol proving credit-score eligibility with Zero-Knowledge Proofs, without revealing the exact score.",
  "scripts": {
    "circuit:test": "npm --prefix circuits test",
    "circuit:compile": "npm --prefix circuits run circuit:compile",
    "circuit:setup": "npm --prefix circuits run circuit:setup",
    "circuit:prove": "npm --prefix circuits run circuit:prove",
    "circuit:verify": "npm --prefix circuits run circuit:verify",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "test": "npm run circuit:test && npm run contracts:test"
  }
}
